{
  "name": "orpc-worker-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^22.19.19",
      "typescript": "^6.0.3",
      "wrangler": "^4.93.0",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:web": "turbo run dev --filter=@app/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "check": "bun run lint && bun run format && bun run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.9.14",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.12"
}
