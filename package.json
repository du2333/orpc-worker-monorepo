{
  "name": "orpc-worker-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/client": "^1.14.3",
      "@orpc/contract": "^1.14.3",
      "@orpc/json-schema": "^1.14.3",
      "@orpc/openapi": "^1.14.3",
      "@orpc/openapi-client": "^1.14.3",
      "@orpc/server": "^1.14.3",
      "@orpc/tanstack-query": "^1.14.3",
      "@orpc/zod": "^1.14.3",
      "@tanstack/devtools-vite": "0.7.0",
      "@tanstack/react-devtools": "0.10.5",
      "@tanstack/react-query": "5.100.11",
      "@tanstack/react-query-devtools": "5.100.11",
      "@tanstack/react-router": "1.170.6",
      "@tanstack/react-router-devtools": "1.167.0",
      "@tanstack/react-router-ssr-query": "1.167.0",
      "@tanstack/react-start": "1.168.9",
      "@types/node": "^22.19.19",
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "^6.0.2",
      "oxfmt": "^0.51.0",
      "oxlint": "^1.66.0",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "turbo": "^2.9.14",
      "typescript": "^6.0.3",
      "vite": "^8.0.13",
      "wrangler": "^4.93.0",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:web": "turbo run dev --filter=@app/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt . '!apps/web/src/routeTree.gen.ts'",
    "format:check": "oxfmt --check . '!apps/web/src/routeTree.gen.ts'",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.12"
}
